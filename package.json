{
  "name": "prismtranscode",
  "version": "2.1.0-beta.1",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "vite --config online/vite.config.js --host 127.0.0.1",
    "build": "node scripts/prepare-online.mjs && vite build --config online/vite.config.js",
    "preview": "vite preview --config online/vite.config.js --host 127.0.0.1",
    "test": "node --test online/tests/unit.test.js",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build"
  },
  "dependencies": { "@ffmpeg/core": "0.12.10", "@ffmpeg/ffmpeg": "0.12.15" },
  "devDependencies": { "@playwright/test": "1.63.0", "vite": "8.3.0" }
}
